{
  "name": "scifunlab-solutions",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.20.2 <21",
    "npm": ">=10.8.2 <11"
  },
  "overrides": {
    "camera-controls": "3.1.0",
    "postcss": "8.5.26",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "gray-matter": {
      "js-yaml": "3.15.2"
    },
    "recharts": {
      "lodash": "4.18.1"
    }
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run solutions:check && next build",
    "start": "next start",
    "lint": "eslint app engine kits books scripts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "solutions:generate": "tsx scripts/generate-solutions-registry.ts --write --kits-dir kits --books-dir books",
    "solutions:check": "tsx scripts/generate-solutions-registry.ts --check --kits-dir kits --books-dir books && tsx --conditions=react-server scripts/check-solutions.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.7",
    "@react-three/fiber": "^9.0.0",
    "@types/node": "^20.11.30",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "next": "15.5.28",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "^2.2.2",
    "temml": "0.11.11",
    "three": "0.177.0",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.22",
    "tailwindcss": "^3.4.1",
    "tsx": "4.23.9",
    "@types/three": "0.177.0"
  }
}
